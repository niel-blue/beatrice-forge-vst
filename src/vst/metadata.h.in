#ifndef BEATRICE_VST_METADATA_H_
#define BEATRICE_VST_METADATA_H_

// clang-format off
#define MAJOR_VERSION          @FORGE_VERSION_MAJOR@
#define MINOR_VERSION          @FORGE_VERSION_MINOR@
#define PATCH_VERSION          @FORGE_VERSION_PATCH@
#define BUILD_NUMBER           @build_number@
#define INTEGER_VERSION        MAJOR_VERSION, MINOR_VERSION, PATCH_VERSION, BUILD_NUMBER
#define FULL_VERSION_STR       "@FORGE_FULL_VERSION_STR@"
#define BASE_VERSION_STR       "@BEATRICE_BASE_VERSION@"

#define stringPluginName       "@BEATRICE_PRODUCT_NAME@ " FULL_VERSION_STR
#define stringOriginalFilename "@BEATRICE_PRODUCT_SLUG@_" FULL_VERSION_STR ".vst3"
#if SMTG_PLATFORM_64
#define stringFileDescription  stringPluginName " (64Bit)"
#else
#define stringFileDescription  stringPluginName
#endif
#define stringCompanyWeb       ""
#define stringCompanyEmail     ""
#define stringCompanyName      "@BEATRICE_AUTHOR_NAME@"
#define stringLegalCopyright   "Copyright 2022-2026 Project Beatrice and Contributors; modifications by @BEATRICE_AUTHOR_NAME@"
#define stringLegalTrademarks  "VST is a trademark of Steinberg Media Technologies GmbH"
#define stringProductComment   "Based on Project Beatrice " BASE_VERSION_STR

#define BACKGROUND_IMAGE       "@background_image@"
// clang-format on

#ifndef RC_INVOKED

#include "vst3sdk/pluginterfaces/base/funknown.h"

namespace beatrice::vst {

#ifdef BEATRICE_ONLY_FOR_LINTER_DO_NOT_COMPILE_WITH_THIS
static const Steinberg::FUID kProcessorUID(0x00000000, 0x00000000, 0x00000000,
                                           0x00000000);
static const Steinberg::FUID kControllerUID(0x00000000, 0x00000000, 0x00000000,
                                            0x00000000);
#else
// clang-format off
static const Steinberg::FUID kProcessorUID(@BEATRICE_PROCESSOR_UID@);
static const Steinberg::FUID kControllerUID(@BEATRICE_CONTROLLER_UID@);
// clang-format on
#endif

}  // namespace beatrice::vst

#endif  // RC_INVOKED

